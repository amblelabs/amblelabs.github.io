---
import { Image } from "astro:assets";
import { YouTube } from "@astro-community/astro-embed-youtube";

import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import Ph from "../components/Ph.astro";

import ambleLogoSvg from "../assets/amblelabs_icon.svg";
import ambleLogoGif from "../assets/amblelabs_icon.gif";
import siteData from "../data/site.json";
import ASCII from "../data/ascii.txt?raw";

const { members, mods, wikis, links, donations } = siteData;

const crew = [
    { label: "Developers", list: members.developers },
    { label: "Art, music & sound", list: members.artists },
    { label: "Community & wiki", list: members.others },
    { label: "Junior developers", list: members.junior_developers },
];

const headcount = crew.reduce((n, g) => n + g.list.length, 0);
const [flagship, ...rest] = mods;
const logotype = ASCII.replace(/\s+$/, "");

const SOCIAL_NAME: Record<string, string> = {
    github: "GitHub",
    codeberg: "Codeberg",
    modrinth: "Modrinth",
    discord: "Discord",
    discordg: "Discord",
    youtube: "YouTube",
    youtubeg: "YouTube",
    tiktok: "TikTok",
    tiktokg: "TikTok",
    bluesky: "Bluesky",
    tumblr: "Tumblr",
    x: "X",
    kofi: "Ko-fi",
    kofig: "Ko-fi",
    boosty: "Boosty",
    boostyg: "Boosty",
    patreon: "Patreon",
    site: "their site",
};
---

<BaseLayout title="AmbleLabs" description={siteData.description}>
    <header class="hero" id="hero">
        <div class="wrap">
            <h1 class="sr-only">AmbleLabs</h1>
            <pre class="ascii enter" aria-hidden="true">{logotype}</pre>
        </div>

        <div class="wrap rail">
            <div class="rail-col">
                <div class="hero-mark">
                    <Image
                        src={ambleLogoSvg}
                        alt=""
                        class="still"
                        width={40}
                        height={40}
                        loading="eager"
                        fetchpriority="high"
                    />
                    <Image
                        src={ambleLogoGif}
                        alt=""
                        class="walk"
                        width={40}
                        height={40}
                        loading="lazy"
                    />
                </div>
                <p class="rail-label">Minecraft mods</p>
                <p class="rail-note">Free &amp; open source</p>
            </div>

            <div class="hero-body enter">
                <p class="hero-thesis">
                    We build science fiction into Minecraft.
                </p>
                <p class="hero-sub">
                    Doctor Who, Stargate and superhero mods for Minecraft. Free,
                    open source, built on Fabric and Forge.
                </p>

                <div class="hero-actions">
                    <a
                        class="btn btn-solid"
                        href={links.modrinth.url}
                        target="_blank"
                        rel="noopener"
                        ><Logo icon="modrinth" alt="" height={16} loading="eager" /> Get the mods</a
                    >
                    <a
                        class="btn"
                        href={links.discord.url}
                        target="_blank"
                        rel="noopener"
                        ><Logo icon="discord" alt="" height={15} loading="eager" /> Join the Discord</a
                    >
                </div>

                <div class="readout">
                    <div>
                        <span class="stat-num" id="totalDownloads">—</span>
                        <span class="stat-label">Downloads
                            <i class="stat-note">via Modrinth</i></span>
                    </div>
                    <div>
                        <span class="stat-num">{mods.length}</span>
                        <span class="stat-label">Mods</span>
                    </div>
                    <div>
                        <span class="stat-num">{headcount}</span>
                        <span class="stat-label">People</span>
                    </div>
                </div>

                <div class="social-strip">
                    {
                        [
                            ["github", links.github],
                            ["codeberg", links.codeberg],
                            ["youtubeg", links.youtube],
                            ["tiktokg", links.tiktok],
                            ["bluesky", links.bluesky],
                        ].map(([icon, link]: any) => (
                            <a
                                href={link.url}
                                target="_blank"
                                rel="noopener"
                                title={link.description}
                            >
                                <Logo
                                    icon={icon}
                                    alt=""
                                    height={15}
                                    loading="lazy"
                                />
                                {link.name}
                            </a>
                        ))
                    }
                </div>
            </div>
        </div>
    </header>

    <section class="section" id="mods">
        <div class="wrap rail">
            <div class="rail-col">
                <span class="node"></span>
                <p class="rail-label"><Ph icon="cube" size={14} /> Projects</p>
                <p class="rail-note">{mods.length} live on Modrinth</p>
            </div>

            <div>
                <div class="section-head reveal">
                    <h2 class="h2">What we make</h2>
                    <p class="lede">
                        Download counts come straight from Modrinth. Everything
                        is free.
                    </p>
                </div>

                <div class="manifest reveal-group">
                    <a
                        class="row row-feature"
                        href={`https://modrinth.com/mod/${flagship.slug}`}
                        target="_blank"
                        rel="noopener"
                        data-slug={flagship.slug}
                    >
                        <Icon
                            icon={`mod/${flagship.slug}.${flagship.icon ?? "webp"}`}
                            alt=""
                            class="mod-icon"
                            width={96}
                            height={96}
                            loading="eager"
                        />
                        <div>
                            <span class="tag">Flagship</span>
                            <h3 class="row-name">{flagship.name}</h3>
                            <p class="row-desc">{flagship.description}</p>
                        </div>
                        <div class="row-side">
                            <p class="row-meta loading">
                                <b class="meta-count">—</b>
                                <span><Ph icon="download-simple" size={12} /> downloads</span>
                            </p>
                            <span class="row-go"><Ph icon="arrow-up-right" size={18} /></span>
                        </div>
                    </a>

                    {
                        rest.map((mod) => (
                            <a
                                class="row"
                                href={`https://modrinth.com/mod/${mod.slug}`}
                                target="_blank"
                                rel="noopener"
                                data-slug={mod.slug}
                            >
                                <Icon
                                    icon={`mod/${mod.slug}.${mod.icon ?? "webp"}`}
                                    alt=""
                                    class="mod-icon"
                                    width={54}
                                    height={54}
                                    loading="lazy"
                                />
                                <div>
                                    <h3 class="row-name">{mod.name}</h3>
                                    <p class="row-desc">{mod.description}</p>
                                </div>
                                <div class="row-side">
                                    <p class="row-meta loading">
                                        <b class="meta-count">—</b>
                                        <span><Ph icon="download-simple" size={12} /> downloads</span>
                                    </p>
                                    <span class="row-go"><Ph icon="arrow-up-right" size={16} /></span>
                                </div>
                            </a>
                        ))
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="section" id="about">
        <div class="wrap rail">
            <div class="rail-col">
                <span class="node"></span>
                <p class="rail-label"><Ph icon="heart" size={14} /> The studio</p>
            </div>

            <div class="reveal">
                <h2 class="h2">Iconic sci-fi,<br />rebuilt block by block</h2>
                <p class="about-text" style="margin-top:24px">
                    {siteData.description}
                </p>
                <p class="about-text">
                    From the TARDIS to Stargates, we bring iconic sci-fi
                    universes into Minecraft with detailed, immersive
                    modifications built on <strong
                        >Fabric &amp; Forge 1.20+</strong
                    >.
                </p>

                <div class="trailer">
                    <YouTube
                        id={siteData.youtube_embed}
                        title="AmbleLabs trailer"
                    />
                </div>
            </div>
        </div>
    </section>

    <section class="section" id="crew">
        <div class="wrap rail">
            <div class="rail-col">
                <span class="node"></span>
                <p class="rail-label"><Ph icon="users-three" size={14} /> Crew</p>
                <p class="rail-note">{headcount} people</p>
            </div>

            <div>
                <div class="section-head reveal">
                    <h2 class="h2">The people behind the mods</h2>
                </div>

                {
                    crew.map((group) => (
                        <div class="crew-group">
                            <h3 class="group-label reveal">
                                {group.label} <b>{group.list.length}</b>
                            </h3>

                            <div class="crew-wall reveal-group">
                                {group.list.map((m: any, i: number) => (
                                    <article class="crew">
                                        <div class="roundel">
                                            <Icon
                                                icon={`team/${m.avatar}`}
                                                alt={m.name}
                                                width={64}
                                                height={64}
                                                loading="lazy"
                                            />
                                        </div>

                                        <h4 class="crew-name">{m.name}</h4>
                                        <p class="crew-role">
                                            {m.role ?? "Junior developer"}
                                        </p>
                                        {m.quote && (
                                            <p class="crew-quote">{m.quote}</p>
                                        )}

                                        <div class="crew-foot">
                                            {m.socials &&
                                                Object.entries(m.socials).map(
                                                    ([type, url]) => (
                                                        <a
                                                            href={url}
                                                            target="_blank"
                                                            rel="noopener"
                                                            aria-label={`${m.name} on ${SOCIAL_NAME[type] ?? type}`}
                                                        >
                                                            <Logo
                                                                icon={type}
                                                                alt=""
                                                                height={16}
                                                                loading="lazy"
                                                            />
                                                        </a>
                                                    ),
                                                )}
                                            {m.link && (
                                                <a
                                                    class="crew-site"
                                                    href={m.link}
                                                    target="_blank"
                                                    rel="noopener"
                                                    aria-label={`${m.name}'s site`}
                                                >
                                                    {m.link
                                                        .replace(
                                                            /^https?:\/\//,
                                                            "",
                                                        )
                                                        .replace(/\/$/, "")}
                                                </a>
                                            )}
                                        </div>
                                    </article>
                                ))}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="section" id="docs">
        <div class="wrap rail">
            <div class="rail-col">
                <span class="node"></span>
                <p class="rail-label"><Ph icon="book-open" size={14} /> Docs</p>
                <p class="rail-note">For players &amp; modders</p>
            </div>

            <div class="manifest reveal-group">
                {
                    wikis.map((w) => (
                        <a
                            class="row row-doc"
                            href={w.url}
                            target={w.url.startsWith("http") ? "_blank" : null}
                            rel="noopener"
                        >
                            <div>
                                <h3 class="row-name">{w.name}</h3>
                                <p class="row-desc">{w.description}</p>
                            </div>
                            <div class="row-side">
                                <span class="row-go"><Ph icon="arrow-up-right" size={16} /></span>
                            </div>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="section" id="support">
        <div class="wrap rail">
            <div class="rail-col">
                <span class="node node-lit"></span>
                <p class="rail-label"><Ph icon="coffee" size={14} /> Support</p>
            </div>

            <div class="reveal">
                <h2 class="support-title">Buy the crew a coffee</h2>
                <p class="support-text">
                    Donations go straight to the people who make the mods.
                </p>

                <div class="donate-wall reveal-group">
                    {
                        donations.map((d) => (
                            <a
                                class="donate"
                                href={d.url}
                                target="_blank"
                                rel="noopener"
                            >
                                <Logo
                                    icon={d.icon}
                                    alt=""
                                    height={22}
                                    loading="lazy"
                                />
                                <span>
                                    <span class="donate-name">{d.name}</span>
                                    <span class="donate-where">
                                        {d.platform}
                                    </span>
                                </span>
                            </a>
                        ))
                    }
                </div>

                <div class="commission">
                    <h2 class="support-title">Want a mod made for you?</h2>
                    <p class="support-text">
                        Tell us what you have in mind and we'll get back to you.
                    </p>
                    <a
                        class="btn btn-solid"
                        href={siteData.commissions}
                        target="_blank"
                        rel="noopener"
                        >Open the form <Ph icon="arrow-up-right" size={15} /></a
                    >
                </div>
            </div>
        </div>
    </section>
</BaseLayout>

<script src="../js/mods.js"></script>
