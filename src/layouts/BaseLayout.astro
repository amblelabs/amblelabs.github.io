---
import { Image } from "astro:assets";
import { AstroFont } from "astro-font";
import ambleLogoSvg from "../assets/amblelabs_icon.svg";
import Footer from "../components/Footer.astro";
import Ph from "../components/Ph.astro";
import "../assets/style.css";
import siteData from "../data/site.json";

export interface Props {
    title?: string;
    description?: string;
}

const { title = "AmbleLabs", description = siteData.tagline } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://amblelabs.dev");

const NAV = [
    { id: "mods", label: "Mods" },
    { id: "crew", label: "Crew" },
    { id: "docs", label: "Docs" },
    { id: "support", label: "Support" },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <link rel="canonical" href={canonical.href} />
        <meta property="og:url" content={canonical.href} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="AmbleLabs" />
        <meta property="og:locale" content="en_GB" />
        <meta name="twitter:card" content="summary" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="icon" type="image/svg+xml" href={ambleLogoSvg.src} />
        <meta name="theme-color" content="#000000" />
        <link rel="preconnect" href="https://api.modrinth.com" />

        <script is:inline>
            document.documentElement.classList.add("js");
        </script>

        <AstroFont
            config={[
                {
                    src: [],
                    name: "Unbounded",
                    googleFontsURL:
                        "https://fonts.googleapis.com/css2?family=Unbounded:wght@700&display=swap",
                    preload: false,
                    display: "swap",
                    fallback: "sans-serif",
                    fetch: true,
                },
                {
                    src: [],
                    name: "Manrope",
                    googleFontsURL:
                        "https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&display=swap",
                    preload: false,
                    display: "swap",
                    fallback: "sans-serif",
                    fetch: true,
                },
                {
                    src: [],
                    name: "IBM Plex Mono",
                    googleFontsURL:
                        "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@700&display=swap",
                    preload: false,
                    display: "swap",
                    fallback: "monospace",
                    fetch: true,
                },
            ]}
        />
    </head>

    <body>
        <a href="#main" class="skip">Skip to content</a>

        <nav class="nav" id="mainNav">
            <div class="nav-inner">
                <a href="/" class="nav-mark">
                    <Image
                        src={ambleLogoSvg}
                        alt=""
                        width={22}
                        height={22}
                        loading="eager"
                        fetchpriority="high"
                    />
                    <span>AmbleLabs</span>
                </a>

                <ul class="nav-links">
                    {
                        NAV.map((item) => (
                            <li>
                                <a
                                    class="nav-link"
                                    href={`/#${item.id}`}
                                    data-section={item.id}
                                >
                                    {item.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>

                <a
                    class="btn btn-solid nav-cta"
                    href={siteData.links.discord.url}
                    target="_blank"
                    rel="noopener">Discord</a
                >

                <button
                    class="nav-burger"
                    id="navBurger"
                    aria-label="Menu"
                    aria-expanded="false"
                    aria-controls="mobileNav"
                >
                    <Ph icon="list" size={20} />
                </button>
            </div>
        </nav>

        <div class="mobile-nav" id="mobileNav">
            {
                NAV.map((item) => (
                    <a class="nav-link" href={`/#${item.id}`}>
                        {item.label}
                    </a>
                ))
            }
            <a
                class="btn btn-solid"
                href={siteData.links.discord.url}
                target="_blank"
                rel="noopener">Join the Discord</a
            >
        </div>

        <main id="main">
            <slot />
        </main>

        <Footer />

        <script src="../js/chrome.js"></script>
    </body>
</html>
