---
import Icon from "./Icon.astro";
import type { HTMLAttributes } from "astro/types";

type ImgAttributes = Omit<HTMLAttributes<"img">, "src" | "width" | "height">;

type Props = {
    icon: string;
    width?: number;
    height?: number;
} & ImgAttributes;

const { icon, class: cls, ...rest } = Astro.props;
---

<Icon
    {...rest}
    class={`logo logo-${icon}${cls ? ` ${cls}` : ""}`}
    icon={`logo/${icon}.svg`}
/>
