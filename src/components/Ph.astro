---
type Props = { icon: string; size?: number; class?: string };
const { icon, size = 16, class: cls } = Astro.props;

const files = import.meta.glob<string>("/src/assets/icon/ph/*.svg", {
    query: "?raw",
    import: "default",
    eager: true,
});

const raw = files[`/src/assets/icon/ph/${icon}.svg`];
if (!raw) throw new Error(`no ph icon: ${icon}`);

const svg = raw
    .replace(/^<svg /, `<svg width="${size}" height="${size}" class="${cls ?? "ph"}" aria-hidden="true" `)
    .replace(/fill="#000000"/g, 'fill="currentColor"');
---

<Fragment set:html={svg} />
