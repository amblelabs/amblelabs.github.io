---
import type { HTMLAttributes } from "astro/types";
import { Image } from "astro:assets";

type ImgAttributes = Omit<HTMLAttributes<"img">, "src" | "width" | "height">;

type Props = {
    icon: string;
    width?: number;
    height?: number;
} & ImgAttributes;

const { icon, ...attrs } = Astro.props;
const path = `/src/assets/icon/${icon}`;

const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/icon/**/*.{jpeg,jpg,png,webp,gif,svg}",
);

if (!images[path]) throw new Error(`missing icon: src/assets/icon/${icon}`);
---

<Image alt="" decoding="async" {...attrs} src={images[path]()} />
