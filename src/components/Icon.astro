---
import type { HTMLAttributes } from "astro/types";
import { Image } from "astro:assets";

type ImgAttributes = Omit<HTMLAttributes<"img">, "src" | "width" | "height">;

type Props = {
    icon: string;
    width?: number;
    height?: number;
    densities?: number[];
    quality?: number;
    format?: "png" | "webp" | "avif" | "jpeg";
} & ImgAttributes;

const { icon, densities, ...attrs } = Astro.props;
const path = `/src/assets/icon/${icon}`;

const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/icon/**/*.{jpeg,jpg,png,webp,gif,svg}",
);

if (!images[path]) throw new Error(`missing icon: src/assets/icon/${icon}`);

const img = (await images[path]()).default;
const top = Math.floor((img.width / (attrs.width ?? img.width)) * 100) / 100;
const d = densities
    ?.map((x) => Math.min(x, top))
    .filter((x, i, a) => x >= 1 && a.indexOf(x) === i);
---

<Image
    alt=""
    decoding="async"
    {...attrs}
    densities={d?.length ? d : undefined}
    src={img}
/>
